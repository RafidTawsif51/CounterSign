# Copy to .env and fill in. Never commit .env.

# Mock flags: true = mock adapter (default for local dev and tests), false = real API.
MOCK_NESSIE=true
MOCK_CRS=true
MOCK_APIFY=true
MOCK_TWILIO=true
MOCK_CARTESIA=true
MOCK_CLAUDE=true      # extraction only
MOCK_INJECTION=false  # injection scanner (Aditya): false = real scanner (local checks; Claude classifier only if MOCK_CLAUDE=false)
MOCK_RISK=false       # risk engine (Aditya): false = real assessor (Claude urgency classifier only if MOCK_CLAUDE=false)

ANTHROPIC_API_KEY=
CLAUDE_MODEL_MAIN=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=          # backend URL Twilio can reach (tunnel locally)
CALL_RECORDING_ENABLED=false   # true only on a Twilio account that can record; the call then says "recorded and transcribed"
TWILIO_REQUIRE_CALL_TOKEN=   # blank = on whenever MOCK_TWILIO=false; true/false forces it. Each call's webhooks carry a per-call secret
TWILIO_VALIDATE_SIGNATURES=false   # true also requires a valid X-Twilio-Signature (trial accounts send none, so keep false on a trial)

CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
STT_API_KEY=

NESSIE_API_KEY=
APIFY_TOKEN=
CRS_API_KEY=

# SQLite locally; use a Postgres URL when deployed.
DATABASE_URL=sqlite:///./countersign.db

DEMO_VENDOR_PHONE=        # teammate phone used as the real vendor
ALLOWED_CALL_NUMBERS=     # comma list; calls to anything else are refused

# Shared secret that the inbound-email provider sends to /api/bounty/inbound
BOUNTY_WEBHOOK_SECRET=
# Postmark inbound webhook URL: https://anything:<BOUNTY_WEBHOOK_SECRET>@<backend host>/api/bounty/inbound
# When set, the moderation routes need the header x-moderator-token (blank = open, for local dev only)
BOUNTY_MODERATOR_TOKEN=

# Directory for uploaded invoice PDFs
UPLOAD_DIR=./uploads

# Extraction cache (SHA-256 of document -> result); rebuild with: python -m scripts.warm_cache
EXTRACT_CACHE_DIR=./.cache/extractions

# Injection classifier cache (content hash -> verdict)
INJECTION_CACHE_DIR=./.cache/injection

# Risk urgency classifier cache (content hash -> verdict)
RISK_CACHE_DIR=./.cache/risk

# Deployed frontend origin allowed by CORS (localhost:5173 is always allowed)
FRONTEND_URL=

# Frontend (Vite), set on the frontend deploy
VITE_API_URL=
